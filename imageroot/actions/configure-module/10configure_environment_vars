import json
import os
import sys
import agent

# Try to parse the stdin as JSON.
# If parsing fails, output everything to stderr
data = json.load(sys.stdin)
rdb = agent.redis_connect(use_replica=True)
smtp_settings = agent.get_smarthost_settings(rdb)

host = data.get("host")
# agent.dump_env()
CREATE_SUPERUSER = data.get("CREATE_SUPERUSER", "admin:admin")
# Bugsink 2 logs users in by email and refuses to start when the
# CREATE_SUPERUSER login is not an email address: put a bare name on the
# module host.
su_login, _, su_password = CREATE_SUPERUSER.partition(":")
if "@" not in su_login:
    su_login = f"{su_login or 'admin'}@{host}"
CREATE_SUPERUSER = f"{su_login}:{su_password or 'admin'}"
PORT = data.get("PORT", "8000")
BEHIND_HTTPS_PROXY = data.get("BEHIND_HTTPS_PROXY", "true")
BASE_URL = f"https://{host}"
TIME_ZONE = data.get("TIME_ZONE", "UTC")
web = {
    "CREATE_SUPERUSER": CREATE_SUPERUSER,
    "PORT": PORT,
    "BEHIND_HTTPS_PROXY": BEHIND_HTTPS_PROXY,
    "BASE_URL": BASE_URL,
    "EMAIL_HOST": smtp_settings["host"],
    "EMAIL_HOST_USER": smtp_settings["username"],
    "EMAIL_HOST_PASSWORD": smtp_settings["password"],
    "EMAIL_PORT": smtp_settings["port"],
    "EMAIL_USE_TLS": "True" if smtp_settings["tls_verify"] else "False",
    "TIME_ZONE": TIME_ZONE,
}
agent.write_envfile("web.env", web)
os.chmod("web.env", 0o600)  # holds the admin and SMTP passwords
